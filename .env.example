# ── Kerala Ayurveda RAG — Environment Configuration ──
#
# Copy to .env and fill in your keys. Every value below has a working default
# except the LLM keys, so a local run only strictly needs one of those.

# ── LLM Providers ──────────────────────────────────────────────
# Primary: MegaLLM (OpenAI-compatible endpoint). Optional — if unset, the
# system goes straight to Gemini.
MEGA_API_KEY=sk-mega-your_megallm_key_here

# Fallback: Google Gemini. Numbered keys are rotated automatically when one
# hits its quota; they are tried in order and the first empty slot ends the
# list, so don't leave a gap.
GOOGLE_API_KEY_1=your_first_google_api_key_here
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=

# Single-key fallback, used only when no numbered keys are present.
# GOOGLE_API_KEY=your_google_api_key_here

# Free Gemini keys: https://aistudio.google.com/app/apikey
# MegaLLM keys: https://megallm.io

# Gemini model for the fallback path. Override to switch to a different
# free-tier quota pool if the default is exhausted.
# GEMINI_MODEL=gemini-3.6-flash

# ── Vector Store ───────────────────────────────────────────────
# Three modes:
#   http://localhost:6333   Qdrant server (docker compose) — use this
#   :memory:                in-process, discarded on exit (tests)
#   ./qdrant_local          in-process, file-backed; single process only
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ayurveda_rag_v2

# ── Embeddings & Reranking (all local, no API cost) ────────────
# Changing EMBEDDING_MODEL invalidates the index — the app will refuse to
# start until you run: python -m scripts.ingest --rebuild
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DEVICE=cpu
SPARSE_MODEL=Qdrant/bm25
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Retrieval ──────────────────────────────────────────────────
# Funnel: TOP_K candidates fused (dense + sparse, RRF) → reranked to TOP_N
# → CONTEXT_N passed to the LLM.
RETRIEVAL_TOP_K=10
RETRIEVAL_TOP_N=5
RETRIEVAL_CONTEXT_N=3

# ── Chunking ───────────────────────────────────────────────────
# Adaptive by document type. Changing these requires a --rebuild.
CHUNK_SIZE_FAQ=400
CHUNK_SIZE_PRODUCT=500
CHUNK_SIZE_GUIDE=800
CHUNK_SIZE_DEFAULT=600
CHUNK_OVERLAP=100

# ── Data & Storage ─────────────────────────────────────────────
CONTENT_DIR=data
UPLOAD_DIR=uploads
DATABASE_URL=sqlite+aiosqlite:///./kerala_ayurveda.db

# ── Cache ──────────────────────────────────────────────────────
# Optional. Without it, an in-process LRU cache is used (works fine for a
# single worker, but doesn't survive restarts or share across processes).
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=86400
CACHE_MAX_SIZE=1000

# ── Agent Workflow ─────────────────────────────────────────────
AGENT_MAX_ITERATIONS=2
AGENT_GROUNDING_THRESHOLD=0.7
AGENT_STYLE_THRESHOLD=0.7
AGENT_TIMEOUT_SECONDS=120

# ── Server ─────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
